# FOCUSFLOW - Root Environment Variables Example
# Do not commit real production secrets

PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/focusflow?schema=public"
WEB_ORIGIN="http://localhost:3000"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="your-jwt-access-secret-32-characters"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-32-characters"

# AI Provider Configuration (Backend-only)
AI_PROVIDER="gemini"
AI_API_KEY="your-ai-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# App Hosting URL
APP_URL="http://localhost:3000"
