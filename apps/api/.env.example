# FOCUSFLOW Backend Environment Configuration Example
# Copy to .env for local backend development

PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/focusflow?schema=public"
WEB_ORIGIN="http://localhost:3000"

# JWT Authentication
JWT_ACCESS_SECRET="your-secure-jwt-access-secret-min-32-chars"
JWT_REFRESH_SECRET="your-secure-jwt-refresh-secret-min-32-chars"

# AI Integration (Gemini / OpenAI)
AI_PROVIDER="gemini"
AI_API_KEY="your-gemini-or-openai-api-key"
